# Smoke test for every endpoint. Run the requests top to bottom against an
# empty event store. Later requests depend on earlier ones, so the expected
# results only hold on a fresh database.
#
# Each request title starts with the expected status code. A "# response:"
# line under the title holds the expected body, recorded before the
# project split. Requests without one return an empty body. Errors are
# application/problem+json, and their expected bodies leave out the
# "traceId", which differs on every request. The expected teams of the tenant
# leave out the id of its default team, which the automation picks at random.

@baseUrl = http://localhost:5039
@subscriptionId = 11111111-1111-1111-1111-111111111111
@userId = 22222222-2222-2222-2222-222222222222
@tenantId = 33333333-3333-3333-3333-333333333333
@teamId = 44444444-4444-4444-4444-444444444444
@projectId = 55555555-5555-5555-5555-555555555555
@keyId = 66666666-6666-6666-6666-666666666666
@secondKeyId = 77777777-7777-7777-7777-777777777777
@unknownId = 99999999-9999-9999-9999-999999999999

### 200 add subscription model
POST {{baseUrl}}/subscription-models
Content-Type: application/json

{ "id": "{{subscriptionId}}", "name": "Basic", "keyLimit": 2 }

### 409 subscription model id taken
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.10","title":"Conflict","status":409,"detail":"A subscription model with this id already exists."}
POST {{baseUrl}}/subscription-models
Content-Type: application/json

{ "id": "{{subscriptionId}}", "name": "Basic", "keyLimit": 2 }

### 200 add user
POST {{baseUrl}}/users
Content-Type: application/json

{ "id": "{{userId}}", "name": "Alice", "email": "alice@example.com" }

### 409 user email taken
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.10","title":"Conflict","status":409,"detail":"A user with this email address already exists."}
POST {{baseUrl}}/users
Content-Type: application/json

{ "id": "{{unknownId}}", "name": "Alice 2", "email": "alice@example.com" }

### 400 register tenant without subscription models
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.1","title":"Bad Request","status":400,"detail":"At least one subscription model must be referenced."}
POST {{baseUrl}}/tenants
Content-Type: application/json

{ "id": "{{tenantId}}", "name": "Acme", "subscriptionModelIds": [] }

### 200 register tenant, after which an automation adds the team "Default"
POST {{baseUrl}}/tenants
Content-Type: application/json

{ "id": "{{tenantId}}", "name": "Acme", "subscriptionModelIds": ["{{subscriptionId}}"] }

### 409 tenant name taken, compared canonically
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.10","title":"Conflict","status":409,"detail":"A tenant with this name already exists."}
POST {{baseUrl}}/tenants
Content-Type: application/json

{ "id": "{{unknownId}}", "name": " ACME ", "subscriptionModelIds": ["{{subscriptionId}}"] }

### 404 register tenant with unknown subscription model
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.5","title":"Not Found","status":404,"detail":"One or more subscription models were not found."}
POST {{baseUrl}}/tenants
Content-Type: application/json

{ "id": "{{unknownId}}", "name": "Other", "subscriptionModelIds": ["{{unknownId}}"] }

### 200 rename tenant to its own name in other casing, no event appended
POST {{baseUrl}}/tenants/{{tenantId}}/rename
Content-Type: application/json

{ "name": "ACME" }

### 200 rename tenant
POST {{baseUrl}}/tenants/{{tenantId}}/rename
Content-Type: application/json

{ "name": "Acme Corp" }

### 404 rename unknown tenant
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.5","title":"Not Found","status":404,"detail":"Tenant not found."}
POST {{baseUrl}}/tenants/{{unknownId}}/rename
Content-Type: application/json

{ "name": "Nobody" }

### 200 assign tenant owner
POST {{baseUrl}}/tenants/{{tenantId}}/owners
Content-Type: application/json

{ "userId": "{{userId}}" }

### 409 user already tenant owner
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.10","title":"Conflict","status":409,"detail":"This user is already an owner of this tenant."}
POST {{baseUrl}}/tenants/{{tenantId}}/owners
Content-Type: application/json

{ "userId": "{{userId}}" }

### 404 assign unknown user as tenant owner
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.5","title":"Not Found","status":404,"detail":"User not found."}
POST {{baseUrl}}/tenants/{{tenantId}}/owners
Content-Type: application/json

{ "userId": "{{unknownId}}" }

### 200 add team
POST {{baseUrl}}/tenants/{{tenantId}}/teams
Content-Type: application/json

{ "id": "{{teamId}}", "name": "Team A", "subscriptionModelId": "{{subscriptionId}}" }

### 400 add team with subscription model the tenant doesn't have
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.1","title":"Bad Request","status":400,"detail":"The specified subscription model is not available in this tenant."}
POST {{baseUrl}}/tenants/{{tenantId}}/teams
Content-Type: application/json

{ "id": "{{unknownId}}", "name": "Team B", "subscriptionModelId": "{{unknownId}}" }

### 409 team name taken
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.10","title":"Conflict","status":409,"detail":"A team with this id or name already exists in this tenant."}
POST {{baseUrl}}/tenants/{{tenantId}}/teams
Content-Type: application/json

{ "id": "{{unknownId}}", "name": "team a", "subscriptionModelId": "{{subscriptionId}}" }

### 200 add project
POST {{baseUrl}}/teams/{{teamId}}/projects
Content-Type: application/json

{ "id": "{{projectId}}", "name": "Web", "referenceLanguage": "en" }

### 409 project name taken
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.10","title":"Conflict","status":409,"detail":"A project with this name already exists in this team."}
POST {{baseUrl}}/teams/{{teamId}}/projects
Content-Type: application/json

{ "id": "{{unknownId}}", "name": "WEB", "referenceLanguage": "en" }

### 404 add project to unknown team
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.5","title":"Not Found","status":404,"detail":"Team not found."}
POST {{baseUrl}}/teams/{{unknownId}}/projects
Content-Type: application/json

{ "id": "{{unknownId}}", "name": "Web", "referenceLanguage": "en" }

### 200 add language
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/languages
Content-Type: application/json

{ "languageCode": "de", "parentLanguageCode": "en" }

### 409 language already added
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.10","title":"Conflict","status":409,"detail":"This language has already been added to the project."}
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/languages
Content-Type: application/json

{ "languageCode": "de", "parentLanguageCode": "en" }

### 400 add the reference language as a language
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.1","title":"Bad Request","status":400,"detail":"The reference language cannot be added as a new language."}
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/languages
Content-Type: application/json

{ "languageCode": "en", "parentLanguageCode": "en" }

### 400 add language with unknown parent language
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.1","title":"Bad Request","status":400,"detail":"The parent language must be the project's reference language or a language already added to the project."}
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/languages
Content-Type: application/json

{ "languageCode": "fr", "parentLanguageCode": "xx" }

### 200 add key
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys
Content-Type: application/json

{ "id": "{{keyId}}", "name": "title" }

### 409 key id taken
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.10","title":"Conflict","status":409,"detail":"Key ID already taken."}
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys
Content-Type: application/json

{ "id": "{{keyId}}", "name": "other" }

### 409 key name taken
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.10","title":"Conflict","status":409,"detail":"Key name already taken."}
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys
Content-Type: application/json

{ "id": "{{secondKeyId}}", "name": "title" }

### 200 add second key, reaching the key limit of 2
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys
Content-Type: application/json

{ "id": "{{secondKeyId}}", "name": "subtitle" }

### 409 key limit reached
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.10","title":"Conflict","status":409,"detail":"The key limit for this team's subscription model has been reached."}
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys
Content-Type: application/json

{ "id": "{{unknownId}}", "name": "third" }

### 200 provide reference text
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys/{{keyId}}/reference-text
Content-Type: application/json

{ "text": "Hello" }

### 200 provide the same reference text again, no event appended
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys/{{keyId}}/reference-text
Content-Type: application/json

{ "text": "Hello" }

### 404 provide reference text for unknown key
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.5","title":"Not Found","status":404,"detail":"Key not found in this project."}
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys/{{unknownId}}/reference-text
Content-Type: application/json

{ "text": "Hello" }

### 200 provide translation
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys/{{keyId}}/translations
Content-Type: application/json

{ "languageCode": "de", "text": "Hallo" }

### 400 provide translation for a language the project doesn't have
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.1","title":"Bad Request","status":400,"detail":"The specified language has not been added to this project."}
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys/{{keyId}}/translations
Content-Type: application/json

{ "languageCode": "fr", "text": "Bonjour" }

### 200 rename key
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys/{{keyId}}/rename
Content-Type: application/json

{ "name": "heading" }

### 200 rename key to its own name, no event appended
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys/{{keyId}}/rename
Content-Type: application/json

{ "name": "heading" }

### 409 rename key to a taken name
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.10","title":"Conflict","status":409,"detail":"A key with this name already exists in this project."}
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys/{{secondKeyId}}/rename
Content-Type: application/json

{ "name": "heading" }

### 200 translations in the reference language
# response: [{"keyId":"66666666-6666-6666-6666-666666666666","keyName":"heading","text":"Hello","sourceLanguageCode":"en"},{"keyId":"77777777-7777-7777-7777-777777777777","keyName":"subtitle","text":null,"sourceLanguageCode":null}]
GET {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/languages/en/translations

### 200 translations in a language with its own text for one key
# response: [{"keyId":"66666666-6666-6666-6666-666666666666","keyName":"heading","text":"Hallo","sourceLanguageCode":"de"},{"keyId":"77777777-7777-7777-7777-777777777777","keyName":"subtitle","text":null,"sourceLanguageCode":null}]
GET {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/languages/de/translations

### 200 withdraw translation
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys/{{keyId}}/translations
Content-Type: application/json

{ "languageCode": "de", "text": null }

### 200 withdraw the same translation again, no event appended
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys/{{keyId}}/translations
Content-Type: application/json

{ "languageCode": "de", "text": null }

### 200 provide an empty reference text
POST {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys/{{secondKeyId}}/reference-text
Content-Type: application/json

{ "text": "" }

### 200 translations inherited again after a withdrawn translation, and an empty text
# response: [{"keyId":"66666666-6666-6666-6666-666666666666","keyName":"heading","text":"Hello","sourceLanguageCode":"en"},{"keyId":"77777777-7777-7777-7777-777777777777","keyName":"subtitle","text":"","sourceLanguageCode":"en"}]
GET {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/languages/de/translations

### 404 translations in a language the project doesn't have
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.5","title":"Not Found","status":404,"detail":"Language not found in this project."}
GET {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/languages/fr/translations

### 200 subscription models
# response: [{"id":"11111111-1111-1111-1111-111111111111","name":"Basic","keyLimit":2}]
GET {{baseUrl}}/subscription-models

### 200 tenants with their subscription models and owners
# response: [{"id":"33333333-3333-3333-3333-333333333333","name":"Acme Corp","subscriptionModels":["Basic"],"owners":["Alice"]}]
GET {{baseUrl}}/tenants

### 200 users
# response: [{"id":"22222222-2222-2222-2222-222222222222","name":"Alice","email":"alice@example.com"}]
GET {{baseUrl}}/users

### 200 details of tenant
# response: {"id":"33333333-3333-3333-3333-333333333333","name":"Acme Corp","subscriptionModels":[{"id":"11111111-1111-1111-1111-111111111111","name":"Basic"}]}
GET {{baseUrl}}/tenants/{{tenantId}}

### 404 details of unknown tenant
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.5","title":"Not Found","status":404,"detail":"Tenant not found."}
GET {{baseUrl}}/tenants/{{unknownId}}

### 200 teams of tenant
# response: [{"name":"Default","subscriptionModel":"Basic"},{"id":"44444444-4444-4444-4444-444444444444","name":"Team A","subscriptionModel":"Basic"}]
GET {{baseUrl}}/tenants/{{tenantId}}/teams

### 200 projects of team with their languages
# response: [{"id":"55555555-5555-5555-5555-555555555555","name":"Web","referenceLanguage":"en","languages":[{"code":"de","parentCode":"en"},{"code":"en","parentCode":null}]}]
GET {{baseUrl}}/teams/{{teamId}}/projects

### 200 keys of project with their own texts
# response: {"referenceLanguage":"en","languages":["de"],"keys":[{"id":"66666666-6666-6666-6666-666666666666","name":"heading","referenceText":"Hello","translations":{"de":"Hallo"}},{"id":"77777777-7777-7777-7777-777777777777","name":"subtitle","referenceText":null,"translations":{}}]}
GET {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/keys

### 404 keys of a project in another team
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.5","title":"Not Found","status":404,"detail":"Project not found in this team."}
GET {{baseUrl}}/teams/{{unknownId}}/projects/{{projectId}}/keys

### 200 languages of project, reference language first
# response: ["en","de"]
GET {{baseUrl}}/teams/{{teamId}}/projects/{{projectId}}/languages

### 404 languages of a project in another team
# response: {"type":"https://tools.ietf.org/html/rfc9110#section-15.5.5","title":"Not Found","status":404,"detail":"Project not found in this team."}
GET {{baseUrl}}/teams/{{unknownId}}/projects/{{projectId}}/languages

### 200 health of every projection and automation, all caught up
# response: {"status":"Healthy","checks":{"app_administration":{"status":"Healthy","description":"Caught up at position 6.","data":{"version":1,"position":6}},"tenant_administration":{"status":"Healthy","description":"Caught up at position 7.","data":{"version":1,"position":7}},"default_team_automation":{"status":"Healthy","description":"Caught up at position 3.","data":{"position":3}},"team_administration":{"status":"Healthy","description":"Caught up at position 9.","data":{"version":1,"position":9}},"translation_editor":{"status":"Healthy","description":"Caught up at position 16.","data":{"version":2,"position":16}},"translation_delivery":{"status":"Healthy","description":"Caught up at position 16.","data":{"version":2,"position":16}}}}
GET {{baseUrl}}/health
